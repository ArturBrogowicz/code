{
 "amendments": [
  {
   "decided": "2026-10-22",
   "id": "A1",
   "post_hoc": true,
   "tests": [
    "V4"
   ],
   "what": "The closed-loop control is judged by the requests that arrive at the origin during the stall (fewer than 10 % of rate x stall), not by its reported p99, which is shown but not counted.",
   "why": "The first run (pilot) showed that wrk 4.1.0 held its connections and sent nothing during the stall, yet reported p99 2.61 s: its percentiles appear to be corrected for coordinated omission after the run, so they do not tell a closed-loop tool from an open-loop one; its arrivals do."
  },
  {
   "decided": "2026-10-22",
   "id": "A2",
   "post_hoc": true,
   "tests": [
    "V3"
   ],
   "what": "Latency is judged from the actual send for every tool. A tool that also reports it from the intended time (loadgen) is judged on both: from the actual send within the V3 tolerance, from the intended time within the slip limit above the origin's, the difference being the schedule slip.",
   "why": "The first run (pilot) showed that loadgen's latency from the actual send agrees with the origin's own within 0.5 ms; the 5 ms by which its reported p99 exceeded it is its schedule slip, which intended-time accounting includes on purpose and the validity limit (p99 slip below 50 ms) bounds."
  },
  {
   "decided": "2026-10-22",
   "id": "C1",
   "post_hoc": false,
   "tests": [
    "V7"
   ],
   "what": "The ceiling needs at least 99 % schedule adherence, read from the origin's counter once a second.",
   "why": "This is the design's own V7 criterion; the first run's harness counted totals only. Not an amendment: jobs that recorded no readings are not judged on it."
  }
 ],
